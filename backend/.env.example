# =========================================================
#  基于 Python 的轻量化 Web 小说平台 · 后端环境变量示例
#  用法：复制为 .env 后修改，.env 不要提交到 Git
#      cp .env.example .env
# =========================================================

# --- 应用 ---
APP_ENV=dev
APP_NAME=novel-platform
APP_PORT=8000

# JWT 签名密钥：必须换成随机长串
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=please-change-me-to-a-random-32-bytes-string
ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=120

# --- 数据库 ---
# 把 your_password 换成你本机 MySQL 的 root 密码
DATABASE_URL=mysql+pymysql://novel_app:your_app_password@127.0.0.1:3306/novel_platform?charset=utf8mb4
DB_ECHO=false

# --- 跨域（开发期前端地址）---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- 访问限流 / 防爬 ---
# 关闭后不做任何限流（仅建议本地调试时临时关闭）
RATE_LIMIT_ENABLED=true

# 可信反向代理（单 IP 或 CIDR，逗号分隔）
# 只有直连地址命中这里，才采信 X-Real-IP / X-Forwarded-For。
#   本机 Nginx           -> 127.0.0.1,::1
#   Docker Compose 网络  -> 172.28.0.0/16
# 配错的后果：所有请求的来源 IP 都变成代理地址，按 IP 限流退化为全站共用一份额度。
TRUSTED_PROXIES=127.0.0.1,::1

# --- 日志 ---
LOG_LEVEL=INFO
LOG_DIR=logs

# --- 静态资源与上传 ---
STATIC_DIR=static
UPLOAD_DIR=static/covers
MAX_UPLOAD_SIZE_MB=2
