# =============================================================
#  docker compose 环境变量
#  用法：cp deploy/.env.docker.example deploy/.env.docker
#        （.env.docker 已被 .gitignore 忽略，不会进仓库）
# =============================================================

# MySQL root 密码（务必修改）
MYSQL_ROOT_PASSWORD=change-me-please

# JWT 签名密钥，至少 32 位随机字符串
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# 允许跨域的来源（前后端同域部署时可只留本机）
CORS_ORIGINS=http://localhost:8080
