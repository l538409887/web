# =============================================================
#  后端镜像：FastAPI + Uvicorn
#  构建：docker build -f deploy/Dockerfile.backend -t novel-backend .
# =============================================================

FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Asia/Shanghai

WORKDIR /app

# 时区与 MySQL 客户端库（PyMySQL 是纯 Python，不需要编译工具）
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl tzdata \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
    && echo $TZ > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

# 先装依赖，利用镜像层缓存
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ /app/

# 运行期可写的目录
RUN mkdir -p /app/logs /app/static/covers \
    && useradd --create-home --shell /usr/sbin/nologin novel \
    && chown -R novel:novel /app

USER novel

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/health || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
